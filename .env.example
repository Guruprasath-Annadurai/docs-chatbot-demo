# Copy this file to .env and change what you need. Everything has a default.

# --- Answers -------------------------------------------------------------
# Leave empty to run without an LLM: the bot then replies with the
# best-matching passage from your documents (extractive mode).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# auto = use the LLM if a key is set, otherwise extractive
# llm = always use the LLM (chat returns a clear error if the key is missing)
# extractive = never call an LLM
ANSWER_MODE=auto

# --- Embeddings ------------------------------------------------------------
# local = sentence-transformers on this machine (free, no key)
# openai = OpenAI embeddings (needs OPENAI_API_KEY)
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval -------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
# Matches below this cosine similarity are ignored. If nothing is left the
# bot says "I don't know". Tuned for all-MiniLM-L6-v2; re-check it if you
# change the embedding model.
SIMILARITY_THRESHOLD=0.40

# --- Data ------------------------------------------------------------------
DATA_DIR=data
SAMPLE_DOCS_DIR=sample_docs
# Load the fictional bakery files on first start (when the index is empty)
LOAD_SAMPLE_DOCS=true

# --- Guardrails and admin --------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
# Protects GET /api/leads/export. Export is switched off while this is empty.
ADMIN_TOKEN=change-me-to-a-long-random-string
# false = uploading and deleting documents also need ADMIN_TOKEN
PUBLIC_UPLOADS=true
MAX_UPLOAD_MB=10
# Comma-separated list of sites allowed to call the API from the widget
ALLOWED_ORIGINS=*

BOT_NAME=Little Crumb Assistant
